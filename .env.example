# ==============================================================================
# NutriPlan Unified Environment Configuration Example
# ==============================================================================

ENVIRONMENT=local
DEBUG=true
FRONTEND_URL=http://localhost:5173

# ── Datastores ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://nutriplan:nutriplan@localhost:5432/nutriplan
PG_BASE_URL=postgresql://nutriplan:nutriplan@localhost:5432
MONGODB_URL=mongodb://localhost:27017/nutriplan
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
MEILISEARCH_URL=http://localhost:7700
MINIO_URL=http://localhost:9000

# ── Security, Encryption & Auth (JWT & HIPAA) ─────────────────────────────────
JWT_SECRET_KEY=your-secure-jwt-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# HIPAA & PHI Cryptographic at-rest encryption (AES-256-GCM base64 32-byte key)
HIPAA_ENCRYPTION_KEY=dGhpc2lzYTMyeWJ0ZWtleWZvcmhpcGFhZW5jcnlwdGlvbg==
HIPAA_FIELD_ENCRYPTION_KEY=dGhpc2lzYTMyeWJ0ZWtleWZvcmhpcGFhZW5jcnlwdGlvbg==

# Keycloak (Optional standalone fallback mode when USE_KEYCLOAK=False)
USE_KEYCLOAK=false
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=nutriplan
KEYCLOAK_CLIENT_ID=nutriplan-web
KEYCLOAK_CLIENT_SECRET=local-secret

# ── Microservice Port URLs & Gateway Discovery ────────────────────────────────
AUTH_SERVICE_URL=http://localhost:8001
COMPLIANCE_SERVICE_URL=http://localhost:8002
PROFILE_SERVICE_URL=http://localhost:8003
RECIPE_SERVICE_URL=http://localhost:8004
DIARY_SERVICE_URL=http://localhost:8005
GROCERY_SERVICE_URL=http://localhost:8006
SUBSCRIPTION_SERVICE_URL=http://localhost:8007
MEAL_PLAN_SERVICE_URL=http://localhost:8009
NOTIFICATION_SERVICE_URL=http://localhost:8010
FOOD_RECOGNITION_SERVICE_URL=http://localhost:8011
CHAT_SERVICE_URL=http://localhost:8012
APPOINTMENT_SERVICE_URL=http://localhost:8013
VIDEO_SERVICE_URL=http://localhost:8014
AI_CHAT_SERVICE_URL=http://localhost:8015
PAYMENT_SERVICE_URL=http://localhost:8016
DELIVERY_SERVICE_URL=http://localhost:8017
WEARABLE_SERVICE_URL=http://localhost:8018
ANALYTICS_SERVICE_URL=http://localhost:8019
ADMIN_SERVICE_URL=http://localhost:8020
MARKETPLACE_SERVICE_URL=http://localhost:8021

# ── Payments (Stripe Connect & Subscriptions) ──────────────────────────────────
STRIPE_SECRET_KEY=sk_test_placeholder_key_here
STRIPE_WEBHOOK_SECRET=whsec_placeholder_webhook_secret
PAYMENT_GATEWAY_SECRET=sk_test_placeholder
PLATFORM_FEE_PERCENT=0.20

# ── AI, LLM & Vision Engines ──────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
LLM_MODEL=llama3
VISION_MODEL=llava

# ── Telehealth & Video Consultation ───────────────────────────────────────────
JITSI_DOMAIN=meet.jit.si
TEMPORAL_HOST_PORT=localhost:7233
TEMPORAL_UI_PORT=8233

# ── Email & Notification Dispatch ─────────────────────────────────────────────
SMTP_HOST=smtp.nutriplan.local
SMTP_PORT=587
SMTP_SENDER=NutriPlan Health <support@nutriplan.local>
