# ==============================================================================
# NutriPlan Unified Environment Configuration — Example
# ==============================================================================
# Copy this file to .env and fill in your values.
#
# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  CENTRALIZED DOMAIN PATTERN — READ THIS FIRST                              ║
# ║                                                                             ║
# ║  APP_DOMAIN is the SINGLE source of truth for the hostname used by         ║
# ║  ALL backend services and the frontend Vite proxy.                         ║
# ║                                                                             ║
# ║  DO NOT hardcode "localhost" (or any domain) anywhere in source code.      ║
# ║  All service URLs are assembled in:                                         ║
# ║    backend → backend/shared/src/nutriplan_shared/service_registry.py       ║
# ║    frontend → frontend/src/config/services.ts                              ║
# ║                                                                             ║
# ║  To switch environments:                                                    ║
# ║    Local dev:    APP_DOMAIN=localhost    APP_SCHEME=http                   ║
# ║    Staging:      APP_DOMAIN=staging.nutriplan.io  APP_SCHEME=https         ║
# ║    Production:   APP_DOMAIN=api.nutriplan.com     APP_SCHEME=https         ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# ── Domain ────────────────────────────────────────────────────────────────────
APP_DOMAIN=localhost
APP_SCHEME=http

ENVIRONMENT=local
DEBUG=true

# Frontend origin — update for staging/prod
FRONTEND_URL=http://localhost:5173
# CORS allowed origins (comma-separated) — consumed by all backend services
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Microservice Ports ────────────────────────────────────────────────────────
# Full URLs are assembled as: {APP_SCHEME}://{APP_DOMAIN}:{APP_PORT_*}
# In Kubernetes/Docker, set APP_DOMAIN to the internal service hostname
# and these ports to the container port.
APP_PORT_AUTH=8001
APP_PORT_COMPLIANCE=8002
APP_PORT_PROFILE=8003
APP_PORT_RECIPE=8004
APP_PORT_DIARY=8005
APP_PORT_GROCERY=8006
APP_PORT_SUBSCRIPTION=8007
APP_PORT_MEAL_PLAN=8009
APP_PORT_NOTIFICATION=8010
APP_PORT_FOOD_RECOGNITION=8011
APP_PORT_CHAT=8012
APP_PORT_APPOINTMENT=8013
APP_PORT_VIDEO=8014
APP_PORT_AI_CHAT=8015
APP_PORT_PAYMENT=8016
APP_PORT_DELIVERY=8017
APP_PORT_WEARABLE=8018
APP_PORT_ADMIN=8019
APP_PORT_FOOD_VISION=8020
APP_PORT_MARKETPLACE=8025
APP_PORT_GATEWAY=8000
APP_PORT_TEMPORAL_UI=8233
APP_PORT_OLLAMA=11434

# ── Datastores ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://nutriplan:nutriplan@localhost:5432/nutriplan
PG_BASE_URL=postgresql://nutriplan:nutriplan@localhost:5432
MONGODB_URL=mongodb://localhost:27017/nutriplan
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
MEILISEARCH_URL=http://localhost:7700
MINIO_URL=http://localhost:9000

# ── Security, Encryption & Auth (JWT & HIPAA) ─────────────────────────────────
JWT_SECRET_KEY=your-secure-jwt-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# HIPAA & PHI Cryptographic at-rest encryption (AES-256-GCM base64 32-byte key)
HIPAA_ENCRYPTION_KEY=dGhpc2lzYTMyeWJ0ZWtleWZvcmhpcGFhZW5jcnlwdGlvbg==
HIPAA_FIELD_ENCRYPTION_KEY=dGhpc2lzYTMyeWJ0ZWtleWZvcmhpcGFhZW5jcnlwdGlvbg==

# Keycloak (Optional standalone fallback mode when USE_KEYCLOAK=False)
USE_KEYCLOAK=false
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=nutriplan
KEYCLOAK_CLIENT_ID=nutriplan-web
KEYCLOAK_CLIENT_SECRET=local-secret

# ── Payments (Stripe Connect & Subscriptions) ──────────────────────────────────
STRIPE_SECRET_KEY=sk_test_placeholder_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_key_here
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_key_here
STRIPE_WEBHOOK_SECRET=whsec_placeholder_webhook_secret
PAYMENT_GATEWAY_SECRET=sk_test_placeholder
PLATFORM_FEE_PERCENT=0.20
TEMPORAL_TASK_QUEUE=booking-task-queue

# ── AI, LLM & Vision Engines ──────────────────────────────────────────────────
LLM_MODEL=llama3
VISION_MODEL=llava
OLLAMA_URL=http://localhost:11434

# ── Telehealth & Video Consultation ───────────────────────────────────────────
JITSI_DOMAIN=meet.jit.si
TEMPORAL_HOST_PORT=localhost:7233

# ── Email & Notification Dispatch ─────────────────────────────────────────────
SMTP_HOST=smtp.nutriplan.local
SMTP_PORT=587
SMTP_SENDER=NutriPlan Health <support@nutriplan.local>

# ── Frontend (Vite) ────────────────────────────────────────────────────────────
# Copy VITE_ vars to frontend/.env as well
VITE_APP_DOMAIN=localhost
VITE_APP_SCHEME=http
VITE_APP_NAME=NutriPlan
